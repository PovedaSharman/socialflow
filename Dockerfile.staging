FROM node:22.12.0-bookworm-slim AS builder

ARG NEXT_PUBLIC_VERSION
ARG STAGING_PUBLIC_URL
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION}
ENV MAIN_URL=${STAGING_PUBLIC_URL}
ENV FRONTEND_URL=${STAGING_PUBLIC_URL}
ENV NEXT_PUBLIC_BACKEND_URL=${STAGING_PUBLIC_URL}/api
ENV NODE_OPTIONS=--max-old-space-size=4096

RUN npm install --global pnpm@10.6.1
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter ./apps/frontend run build \
  && pnpm --filter ./apps/backend run build \
  && pnpm --filter ./apps/orchestrator run build

FROM node:22.12.0-bookworm-slim AS runtime

ENV NODE_ENV=staging
ENV NODE_OPTIONS=--max-old-space-size=1024
RUN npm install --global pnpm@10.6.1 \
  && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /uploads \
  && chown node:node /uploads

WORKDIR /app
COPY --from=builder --chown=node:node /app /app
USER node

CMD ["pnpm", "start:prod:frontend"]
