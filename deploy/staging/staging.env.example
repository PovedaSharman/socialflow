# Copy to staging.env on the server, chmod 600, and replace every placeholder.
STAGING_HOSTNAME=app.203-0-113-10.sslip.io
ACME_EMAIL=operator@example.com
SOCIALFLOW_IMAGE=ghcr.io/owner/repository:staging-commitsha
UPLOAD_HOST_PATH=/srv/socialflow/uploads

POSTGRES_USER=socialflow
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=socialflow_staging
REDIS_PASSWORD=replace-with-a-different-long-random-value

JWT_SECRET=replace-with-at-least-32-random-bytes
SOCIAL_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=staging-2026-08
SOCIAL_CREDENTIAL_ENCRYPTION_KEYS='{"staging-2026-08":"replace-with-base64-encoded-32-byte-key"}'
AUDIT_IP_HMAC_KEY=replace-with-an-independent-random-value

DISABLE_REGISTRATION=false
ENABLE_TEST_PROVIDER=true

# Test/Sandbox values only. Leave blank until the Stripe concurrency fix has
# passing online evidence. Never put sk_live_ keys in this file.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
